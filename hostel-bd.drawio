        <mxCell id="guests" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;align=left;spacingLeft=10;spacingTop=8;" value="&lt;b&gt;GUESTS&lt;/b&gt;&lt;hr&gt;PK id : BIGINT&lt;br&gt;FK user_id : BIGINT NULL&lt;br&gt;first_name : VARCHAR(100)&lt;br&gt;last_name : VARCHAR(100)&lt;br&gt;patronymic : VARCHAR(100)&lt;br&gt;comment : TEXT" vertex="1">
          <mxGeometry height="190" width="280" x="80" y="390" as="geometry" />
