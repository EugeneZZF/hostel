        <mxCell id="payments" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;align=left;spacingLeft=10;spacingTop=8;" value="&lt;b&gt;PAYMENTS&lt;/b&gt;&lt;hr&gt;PK id : BIGINT&lt;br&gt;FK booking_id : BIGINT&lt;br&gt;amount : DECIMAL(10,2)&lt;br&gt;paid_at : TIMESTAMP&lt;br&gt;status : VARCHAR(30)&lt;br&gt;payment_method : VARCHAR(30)" vertex="1">
