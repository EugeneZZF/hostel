<mxfile host="app.diagrams.net">
  <diagram name="Hotel Database" id="hotel-db">
    <mxGraphModel dx="595" dy="388" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="users" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;align=left;spacingLeft=10;spacingTop=8;" value="&lt;b&gt;USERS&lt;/b&gt;&lt;hr&gt;PK id : BIGINT&lt;br&gt;email : VARCHAR(255) UNIQUE&lt;br&gt;password : VARCHAR(255)&lt;br&gt;first_name : VARCHAR(100)&lt;br&gt;last_name : VARCHAR(100)&lt;br&gt;patronymic : VARCHAR(100)&lt;br&gt;created_at : TIMESTAMP" vertex="1">
