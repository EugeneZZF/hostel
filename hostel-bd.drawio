          <mxGeometry height="170" width="280" x="760" y="80" as="geometry" />
        </mxCell>
        <mxCell id="bookings" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;align=left;spacingLeft=10;spacingTop=8;" value="&lt;b&gt;BOOKINGS&lt;/b&gt;&lt;hr&gt;PK id : BIGINT&lt;br&gt;FK user_id : BIGINT&lt;br&gt;FK room_id : BIGINT&lt;br&gt;check_in : DATE&lt;br&gt;check_out : DATE NULL&lt;br&gt;created_at : TIMESTAMP&lt;br&gt;status : VARCHAR(30)" vertex="1">
